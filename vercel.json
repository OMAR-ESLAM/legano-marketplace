{
  "redirects": [
    {
      "source": "/lawyer.html",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "(?<id>[0-9a-fA-F-]{36})"
        }
      ],
      "destination": "/lawyer/:id",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/api/seo?r=robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo?r=sitemap"
    },
    {
      "source": "/lawyer/:id",
      "destination": "/api/seo?r=lawyer&id=:id"
    },
    {
      "source": "/lawyers",
      "destination": "/api/seo?r=list"
    },
    {
      "source": "/lawyers/:cat",
      "destination": "/api/seo?r=list&cat=:cat"
    },
    {
      "source": "/lawyers/:cat/:city",
      "destination": "/api/seo?r=list&cat=:cat&city=:city"
    }
  ],
  "crons": [
    {
      "path": "/api/consult-purge",
      "schedule": "0 3 * * *"
    }
  ]
}